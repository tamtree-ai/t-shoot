{
  "name": "t-shoot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:standalone": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-standalone.ts",
    "tamtree:vendor": "bash scripts/vendor-tamtree-types.sh",
    "worker": "tsx --conditions=react-server --env-file=.env.local src/worker/index.ts",
    "test:e2e": "playwright test",
    "test:standalone": "playwright test -c playwright.standalone.config.ts",
    "stickstage:vendor": "bash scripts/vendor-stickstage.sh",
    "tamtree:provision": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/provision-tamtree.ts",
    "eval:writer": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/eval-stick-writer.ts",
    "mcp": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/mcp.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/openai-compatible": "^3.0.60",
    "@remotion/captions": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "ai": "^7.0.123",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stickstage": "file:vendor/stickstage-0.1.0.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.17.0",
  "optionalDependencies": {
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "^1.2.1"
  }
}
