# Copy to .env.local.

DATABASE_URL=postgres://tamshoot:tamshoot@localhost:5433/tamshoot

# mock (Track F) | live (Track W1: needs the two below)
TAMTREE_ADAPTER=mock
# happy | three-hearts | slow | refusal | over-limit
TAMSHOOT_MOCK_SCENARIO=three-hearts
# 1 = nominal timings (a clip takes ~12s); 10 = ten times faster
TAMSHOOT_MOCK_SPEED=1

# live only. Runtime key scopes: run:flow read:runs read:assets read:usage. TAMTREE_FLOW_IDS from
# `pnpm tamtree:provision` (which alone needs a write:flows key, TAMTREE_PROVISION_KEY).
# TAMTREE_BASE_URL=http://localhost:8000
# TAMTREE_API_KEY=            # scopes: run:flow read:runs read:assets read:usage — never admin
# pnpm tamtree:provision only: credential ids for the names the flows use.
# TAMTREE_CREDENTIAL_IDS=stickstage=<uuid>,openrouter=<uuid>
