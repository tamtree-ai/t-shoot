# Copy to .env.local.

DATABASE_URL=postgres://tamshoot:tamshoot@localhost:5433/tamshoot

# mock (Track F) | live (Track W1: needs the two below) | local (standalone: StickStage + Kokoro, no Tamtree)
TAMTREE_ADAPTER=mock
# happy | three-hearts | slow | refusal | over-limit
TAMSHOOT_MOCK_SCENARIO=three-hearts
# 1 = nominal timings (a clip takes ~12s); 10 = ten times faster
TAMSHOOT_MOCK_SPEED=1

# live only. Runtime key scopes: run:flow read:runs read:assets read:usage. TAMTREE_FLOW_IDS from
# `pnpm tamtree:provision` (which alone needs a write:flows key, TAMTREE_PROVISION_KEY).
# TAMTREE_BASE_URL=http://localhost:8000
# TAMTREE_API_KEY=            # scopes: run:flow read:runs read:assets read:usage — never admin
# pnpm tamtree:provision only: credential ids for the names the flows use.
# TAMTREE_CREDENTIAL_IDS=stickstage=<uuid>,openrouter=<uuid>

# Magic links are printed on the sign-in page outside production. Set 1 to show them in production too.
# TAMSHOOT_SHOW_MAGIC_LINK=1
# Optional webhook that receives the same mail the outbox stores.
# MAIL_WEBHOOK_URL=
# Reserved. YouTube's public API has no title test, so this does not call YouTube.
# YOUTUBE_TITLE_TEST=1
# Results stay empty until a connector token is set. The poller does not invent API calls.
# YOUTUBE_ANALYTICS_TOKEN=
# INSTAGRAM_INSIGHTS_TOKEN=

# local (standalone) only. The StickStage render service, and where runs and assets are kept.
# STICKSTAGE_URL=http://127.0.0.1:8787
# STICKSTAGE_API_TOKEN=          # empty when StickStage runs with --insecure-local
# TAMSHOOT_LOCAL_DIR=.local-engine
# TAMSHOOT_AUTH=local            # one owner, signed in, no email. Refused unless TAMTREE_ADAPTER=local
# Your own writer model (optional): any OpenAI-compatible server, or Anthropic.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3:8b
# LOCAL_LLM_API_KEY=
# Voices: Kokoro in-process by default; or any OpenAI-compatible /audio/speech.
# LOCAL_TTS_BASE_URL=
# KOKORO_CACHE_DIR=              # default ~/.cache/stickstage/kokoro
